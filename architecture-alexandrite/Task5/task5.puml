@startuml
actor Оператор
participant "MES" as FE
participant "MES API" as BE
participant "Redis Cache" as Cache
participant "Database" as DB

== Запрос списка заказов ==
Оператор -> FE : Запрос списка заказов
FE -> Cache : Проверка кеша
alt Заказы есть в кеше
    Cache -> FE : Возвращаем кешированные заказы
else Заказов нет в кеше
    FE -> BE : Запрос списка заказов
    BE -> DB : Запрос списка заказов
    DB -> BE : Возвращает заказы
    BE -> Cache : Сохраняем заказы в кеш
    BE -> FE : Возвращаем заказы
end
FE -> Оператор : Отображаем заказы

== Изменение статуса заказа ==
Оператор -> FE : Изменение статуса заказа
FE -> BE : Отправляем новый статус
BE -> DB : Обновляем статус в базе
BE -> Cache : Удаляем кеш списка заказов
BE -> FE : Подтверждаем изменение
FE -> Оператор : Обновляем интерфейс
@enduml